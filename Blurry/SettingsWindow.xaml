<Window x:Class="Blurry.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blurry Settings"
        Width="380" Height="400"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">

        <!-- Blur settings -->
        <TextBlock Text="Blur" Margin="0,0,0,5"/>
        <Slider x:Name="BlurSlider" Minimum="0" Maximum="100" Value="25"/>
        <TextBlock x:Name="BlurValueText" Text="25" HorizontalAlignment="Right"/>

        <Separator Margin="0,10,0,10"/>

        <!-- Monitors -->
        <TextBlock Text="Monitors:" FontWeight="Bold" Margin="0,0,0,5"/>

        <ItemsControl x:Name="MonitorItems">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Width="220"/>
                        <Button Content="{Binding ButtonText}" 
                                Width="100"
                                Tag="{Binding Screen}"
                                Click="ToggleMonitor_Click"/>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator Margin="0,10,0,10"/>

        <Button Content="Exit" Margin="0,10,0,0" Click="OnCloseClick"/>
    </StackPanel>
</Window>
