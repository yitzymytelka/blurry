<Window x:Class="Blurry.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blurry Settings"
        Width="300" Height="200"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Blur" Margin="0,0,0,5"/>
        <Slider x:Name="BlurSlider" Minimum="0" Maximum="100" Value="25"/>
        <TextBlock x:Name="BlurValueText" Text="25" HorizontalAlignment="Right"/>
        <Button Content="Exit" Margin="0,10,0,0" Click="OnCloseClick"/>
    </StackPanel>
</Window>
