<Window x:Class="Blurry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blurry"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">
    <Grid x:Name="RootGrid" Background="#80000000">
        <Grid.Effect>
            <BlurEffect x:Name="BlurFx" Radius="25"/>
        </Grid.Effect>
    </Grid>
</Window>
